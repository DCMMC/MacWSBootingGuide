# No shebang: dpkg invokes maintainer scripts through its shell.
#
# The old maintainer script ran the entire MacWS runtime repair synchronously.
# A single missing rootfs file, trustcache entry, or optional helper therefore
# made dpkg report "error configuring package" even though the package files
# themselves were already installed. Keep Debian configuration transactional:
# install the privileged onboarding daemon, start the runtime repair in the
# background, and return success to dpkg. The app exposes the Russian setup and
# launch controls and shows the background log/status to the user.

set +e

RUNDIR=/var/jb/var/run
LOGDIR=/var/jb/var/log
SETUP_PLIST=/var/jb/Library/LaunchDaemons/com.macwsguide.onboarding.plist
POSTINST=/var/jb/usr/macOS/bin/postinst.sh
BASH=/var/jb/usr/bin/bash
LAUNCHCTL=/var/jb/usr/bin/launchctl

mkdir -p "$RUNDIR" "$LOGDIR"

if [ -f "$SETUP_PLIST" ]; then
    chown root:wheel "$SETUP_PLIST" 2>/dev/null || true
    chmod 0644 "$SETUP_PLIST" 2>/dev/null || true
    "$LAUNCHCTL" unload "$SETUP_PLIST" >/dev/null 2>&1 || true
    "$LAUNCHCTL" load "$SETUP_PLIST" >/dev/null 2>&1 || true
fi

if [ -x "$BASH" ] && [ -f "$POSTINST" ]; then
    "$BASH" "$POSTINST" >>"$LOGDIR/macws-postinst.log" 2>&1 < /dev/null &
fi

printf '%s\n' 'MacWS RootHide package configured; runtime provisioning continues in background.' > "$LOGDIR/macws-dpkg-configured"
exit 0
