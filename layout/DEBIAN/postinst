# No shebang: this jailbreak's AMFI blocks execve of shebang scripts. dpkg
# invokes maintainer scripts through its shell.

HOSTD=/var/jb/usr/macOS/bin/macwshostd
HOSTD_PLIST=/var/jb/Library/LaunchDaemons/com.macwsguide.hostd.plist
LEGACY_GLASS_PLIST=/var/jb/Library/LaunchDaemons/com.macwsguide.glassdemo.plist
DISABLED_DAEMONS=/var/jb/usr/macOS/disabled-launchdaemons
MACHO_PATCHER=/var/jb/usr/macOS/bin/set_macos_version.py
LIBMACHOOK=/var/jb/usr/macOS/lib/libmachook.dylib
LIBMACHOOK_ARM64=/var/jb/usr/macOS/lib/libmachook_arm64.dylib
ENTITLEMENTS=/var/jb/usr/macOS/bin/entitlements.plist
LIPO=/var/jb/usr/bin/lipo

# Theos builds libmachook for iOS and the chroot's macOS dyld rejects that
# LC_BUILD_VERSION. This used to be a mandatory SSH-only step after every
# package install. Do it before publishing the App's root control service so a
# first launch can repair trustcaches and start the workspace by itself.
if [ -f "$MACHO_PATCHER" ] && [ -f "$LIBMACHOOK" ]; then
    /var/jb/usr/bin/python3 "$MACHO_PATCHER" "$LIBMACHOOK" || exit 1
    if "$LIPO" -info "$LIBMACHOOK" 2>&1 | grep -q 'Architectures in the fat file'; then
        tmp_arm64e="${LIBMACHOOK}.arm64e-new-$$"
        tmp_arm64="${LIBMACHOOK_ARM64}.new-$$"
        "$LIPO" "$LIBMACHOOK" -thin arm64e -output "$tmp_arm64e" || exit 1
        "$LIPO" "$LIBMACHOOK" -thin arm64 -output "$tmp_arm64" || {
            rm -f "$tmp_arm64e"
            exit 1
        }
        chmod 755 "$tmp_arm64e" "$tmp_arm64"
        mv "$tmp_arm64e" "$LIBMACHOOK"
        mv "$tmp_arm64" "$LIBMACHOOK_ARM64"
        echo 'Split libmachook into thin arm64e + arm64 injection libraries.'
    fi
    if [ ! -f "$LIBMACHOOK_ARM64" ]; then
        echo 'macOS Host install failed: thin arm64 libmachook is missing.' >&2
        exit 1
    fi
    for lib in "$LIBMACHOOK" "$LIBMACHOOK_ARM64"; do
        # Fresh lipo output needs two signing passes before its page hashes are
        # stable on this ldid build (runtime-confirmed Invalid Page otherwise).
        /var/jb/usr/bin/ldid -S"$ENTITLEMENTS" -M "$lib" || exit 1
        /var/jb/usr/bin/ldid -S"$ENTITLEMENTS" -M "$lib" || exit 1
    done
fi

# Older manual native-AGX tests installed GlassDemo as RunAtLoad.  That job
# races WindowServer after every userspace restart and bypasses the new app
# control plane.  Preserve it for forensics, but remove it from launchd's
# auto-scanned directory.
if [ -f "$LEGACY_GLASS_PLIST" ]; then
    /var/jb/usr/bin/launchctl unload "$LEGACY_GLASS_PLIST" 2>/dev/null || true
    mkdir -p "$DISABLED_DAEMONS"
    mv "$LEGACY_GLASS_PLIST" "$DISABLED_DAEMONS/com.macwsguide.glassdemo.plist"
fi

if [ -f "$HOSTD_PLIST" ]; then
    chown root:wheel "$HOSTD_PLIST" 2>/dev/null || true
    chmod 644 "$HOSTD_PLIST" 2>/dev/null || true
fi

if [ -x "$HOSTD" ]; then
    for arch in arm64 arm64e; do
        hash=$(/var/jb/usr/bin/ldid -arch "$arch" -h "$HOSTD" 2>/dev/null \
            | grep CDHash= | cut -c8-)
        [ -n "$hash" ] && /var/jb/usr/bin/jbctl trustcache add "$hash" 2>/dev/null || true
    done
fi

for lib in "$LIBMACHOOK" "$LIBMACHOOK_ARM64"; do
    [ -f "$lib" ] || continue
    for arch in arm64 arm64e; do
        hash=$(/var/jb/usr/bin/ldid -arch "$arch" -h "$lib" 2>/dev/null \
            | grep CDHash= | cut -c8-)
        [ -n "$hash" ] && /var/jb/usr/bin/jbctl trustcache add "$hash" 2>/dev/null || true
    done
done

if [ -f "$HOSTD_PLIST" ]; then
    /var/jb/usr/bin/launchctl unload "$HOSTD_PLIST" 2>/dev/null || true
    /var/jb/usr/bin/launchctl load "$HOSTD_PLIST" 2>/dev/null || true
fi

if [ -x /var/jb/usr/bin/uicache ]; then
    /var/jb/usr/bin/uicache -p /var/jb/Applications/MacWSHost.app 2>/dev/null || true
fi

echo 'MacWS Host installed. Open the app to initialize, repair, start, and control macOS.'
