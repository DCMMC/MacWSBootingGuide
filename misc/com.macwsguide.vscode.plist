<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Launch job for the UUID-locked arm64 Visual Studio Code build. -->
    <key>Label</key>
    <string>UIKitApplication:com.macwsguide.vscode</string>
    <key>ProgramArguments</key>
    <array>
        <string>/var/jb/usr/macOS/bin/launchdchrootexec</string>
        <string>0</string>
        <string>0</string>
        <string>/var/mnt/rootfs</string>
        <string>/Applications/Visual Studio Code.app/Contents/MacOS/Electron</string>
		<!-- Runtime-confirmed on 2026-08-22: the native-Metal profile published
		     a real visible NSWindow, but both the WindowServer and macPad captures
		     showed black client pixels while the GPU helper repeatedly reported
		     Completed MTLCommandBuffer failed / Internal Error 00000102/103.
		     Use Chromium's supported software-compositing mode for this 2D editor
		     instead of declaring a geometrically valid black window ready. Keep
		     the profile isolated; never delete or rewrite the user's normal VS
		     Code profile. -->
		<string>--user-data-dir=/tmp/macws-vscode-profile-software-composite1</string>
        <string>--extensions-dir=/tmp/macws-vscode-extensions</string>
        <string>--disable-updates</string>
        <!-- launchdchrootexec already supplies the complete chroot HOME, USER,
             TMPDIR, SHELL and executable environment.  Use VS Code's supported
             switch to skip the main service's redundant login-shell probe.
             VS Code 1.130's ptyHost deliberately does not inherit these CLI
             arguments; libmachook implements that service's exact
             VSCODE_RESOLVING_ENVIRONMENT token+JSON printer protocol without
             starting a second full Chromium instance. -->
        <string>--force-disable-user-env</string>
        <string>--no-sandbox</string>
        <string>--remote-debugging-port=9222</string>
        <string>--remote-allow-origins=*</string>
        <string>--disable-gpu</string>
        <!-- Keep Graphite off as part of the explicit software compositor
             contract; Skia's ordinary CPU raster path remains enabled. -->
        <string>--disable-features=SkiaGraphite</string>
        <!-- Keep Chromium's production JIT scheduling.  The W^X adapter now
             reports successful RX transitions without late retries, while a
             runtime sample with the old no-concurrent option group found the
             Electron main thread permanently waiting in
             OptimizingCompileTaskExecutor::WaitUntilCompilationJobsDoneForIsolate. -->
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CA_VSYNC_OFF</key>
        <string>1</string>
        <key>CA_DISABLE_SWAP_ICC</key>
        <string>1</string>
        <key>MACWS_JIT_MPROTECT_COMPAT</key>
        <string>1</string>
        <!-- iOS 16 cannot provide macOS MAP_JIT/APRR.  Keep the V8 CodeRange
             RX and turn only the 16-KiB page hit by a scoped writer's data
             SIGBUS into RW; the last writer restores those pages RX.  This
             replaces the legacy 256-MiB whole-range flip, which runtime logs
             measured at 23k flips / 6.7k instruction-fetch waits in 30s. -->
        <key>MACWS_JIT_FAULT_WRITE_COMPAT</key>
        <string>1</string>
        <key>MACWS_AMFI_IMMOVABLE_TASK_PORT_COMPAT</key>
        <string>1</string>
        <key>MACWS_MACOS_SYSTEM_POLICY_COMPAT</key>
        <string>1</string>
        <!-- NSOpenPanel/FinderKit is a CoreServices filesystem-catalog
             consumer.  Keep the chroot root as its logical volume root so
             FileCache cannot construct a host-mount parent cycle.  The
             underlying statfs/fsgetpath adapters are dyld interposes and are
             therefore safe across Electron's early fork. -->
        <key>MACWS_APP_MOUNT_COMPAT</key>
        <string>1</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <false/>
    <!-- VS Code is a foreground GUI workload even though the chroot bridge
         must submit it as a launchd job.  Without this declaration launchd
         assigns the job the adaptive daemon spawn type; the controlled
         CVDisplayLink witness then receives callbacks tens of milliseconds
         after their output timestamps while an interactive-shell control on
         the same display remains at 119 Hz. -->
    <key>ProcessType</key>
    <string>Interactive</string>
    <key>StandardOutPath</key>
    <string>/var/jb/var/mobile/vscode.log</string>
    <key>StandardErrorPath</key>
    <string>/var/jb/var/mobile/vscode.log</string>
</dict>
</plist>
