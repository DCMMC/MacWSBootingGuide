{
  "name": "macws-aquarium-runner",
  "displayName": "MacWS Aquarium Runner",
  "description": "Opens the repeatable WebGL Aquarium workload in VS Code's built-in Simple Browser.",
  "version": "0.0.1",
  "publisher": "macwsguide",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:macwsAquarium.open"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "macwsAquarium.open",
        "title": "Open WebGL Aquarium",
        "category": "MacWS"
      }
    ],
    "configuration": {
      "title": "MacWS Aquarium Runner",
      "properties": {
        "macwsAquarium.url": {
          "type": "string",
          "default": "https://webglsamples.org/aquarium/aquarium.html?numFish=1000&canvasWidth=1024&canvasHeight=1024&fitWindow=false",
          "description": "WebGL workload URL opened in VS Code's built-in Simple Browser."
        },
        "macwsAquarium.openOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Open the workload automatically after the VS Code workbench becomes ready."
        }
      }
    }
  }
}
